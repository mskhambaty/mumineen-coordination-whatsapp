META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=choose-a-strong-random-string
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_PHONE_NUMBER_IDS=
WHATSAPP_DISPLAY_PHONE_NUMBER=+16308190250
# Friendly name for this number in the send console's "Send from" picker (e.g. "AI Bot").
WHATSAPP_DISPLAY_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Estimated per-message cost (USD) for a paid (out-of-window) utility template send.
# WhatsApp utility messages are ~$4 per 1000 delivered = 0.004 each. Display-only
# (admin Send Templates console cost estimate); not billed.
WHATSAPP_UTILITY_MSG_COST_USD=0.004
# Hours of the WhatsApp customer-service window treated as "free" (in-window) in the
# Send Templates console. Meta's billing window is 24h; set BELOW 24 for a conservative
# safety margin (e.g. 14 → people who haven't messaged in 14h count as paid). Defaults to 24.
WHATSAPP_WINDOW_HOURS=24
# Approved Meta template for the nightly department digest WhatsApp message.
# Two body vars: {{1}} department name, {{2}} short summary.
DEPARTMENT_SUMMARY_WA_TEMPLATE=daily_department_issue_confirmation
# WhatsApp Business Account ID. Required for all template notifications (welcome,
# issue department_ticket_assigned, escalation escalation_ticket_assigned) — used to
# resolve the approved template from Meta. Without it, only the email channel sends.
WHATSAPP_BUSINESS_ACCOUNT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Standard chat model. GPT-5.x ids (e.g. gpt-5.4-mini) are supported — request shape is adapted
# automatically by chatParams() in src/lib/ai/model.ts.
OPENAI_MODEL=gpt-4o-mini
# Higher-end model used only for Waaz Talaqi / Lisan answers (e.g. gpt-5.4). Falls back to
# OPENAI_MODEL if unset; also falls back at runtime if the configured model errors.
OPENAI_MODEL_HIGH=
NEXT_PUBLIC_APP_URL=https://www.chicagorelaycenter.com
ADMIN_FALLBACK_PASSWORD=
RELAY_SITE_ROOT=https://ashara1448relay.chicagojamaat.org
HOTEL_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1Zf0hoZ0Sty66e9_k4fEDhdEwWclbF0mG9ZvzbqotYF8/export?format=csv
# Signs portal session cookies (HMAC-SHA256). Falls back to ADMIN_API_KEY if unset — set a dedicated value in production.
SESSION_SECRET=
# Server-to-server auth for agent tools and cron jobs. Never sent to the browser.
ADMIN_API_KEY=

# Public CSV export URL of the Knowledge Gaps Google Sheet (File → Share → Publish to web → CSV).
# The cron at /api/cron/sync-gaps-sheet reads this every 2 hours and indexes answered rows.
GAPS_SHEET_CSV_URL=

POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=info@cysora.com
# Additional recipient for Lisan missing-word / word-added alerts, on top of the religious-monitor
# team (added on Waaz Talaqqi → Team). Optional — unset just means only the monitors are emailed.
LISAN_ALERT_EMAIL=
# Link the agent suggests for deeper guidance (can't-answer / deep religious chat). Has a sensible default.
ISTIBSAAR_ONCALL_URL=
POSTMARK_PASSWORD_RESET_TEMPLATE=password-reset
POSTMARK_WELCOME_ADMIN_TEMPLATE=welcome-admin-email
POSTMARK_ASSIGNMENT_TEMPLATE=assignment-notification
# Postmark template for the nightly department digest email.
# Model: department_name, feedback_html, feedback_text.
POSTMARK_DEPARTMENT_SUMMARY_TEMPLATE=daily-department-summary

# Toggle WhatsApp sends in the nightly department digest (set to "true" to enable).
DIGEST_WHATSAPP_ENABLED=false

# Targeted feedback surveys: WhatsApp dispatch of per-recipient survey links. Off by default so the
# feature works (sample + exportable links) without waiting on Meta template approval.
SURVEY_SEND_ENABLED=false
# Approved WhatsApp template (URL-button) used to send the survey link; {{1}} URL suffix = token.
SURVEY_WA_TEMPLATE=

# Optional, enables X-Hub-Signature-256 validation for Meta webhook POSTs.
META_APP_SECRET=

# --- Second WhatsApp number (optional "broadcast" account) ------------------------------------
# A second WhatsApp number — typically a higher-tier number used to broadcast templates — lives in
# its own WhatsApp Business Account under its own Meta App, so it has its own access token, app
# secret, and webhook verify token. Leave these unset for a single-number deployment (the app then
# resolves only the primary account and behaves exactly as before).
#
# Its inbound webhook uses the SAME shared callback URL as the primary number:
#   {NEXT_PUBLIC_APP_URL}/api/whatsapp/webhook
# Point this Meta App's callback there and set its verify token to META_WEBHOOK_VERIFY_TOKEN_BROADCAST
# below. The handler routes each delivery to the right number by metadata.phone_number_id. Replies to
# this number are sent from this number automatically; handling is identical to the primary number.
WHATSAPP_PHONE_NUMBER_ID_BROADCAST=
WHATSAPP_ACCESS_TOKEN_BROADCAST=
WHATSAPP_BUSINESS_ACCOUNT_ID_BROADCAST=
META_APP_SECRET_BROADCAST=
META_WEBHOOK_VERIFY_TOKEN_BROADCAST=
WHATSAPP_DISPLAY_PHONE_NUMBER_BROADCAST=
# Friendly name for the broadcast number in the send console's "Send from" picker (e.g. "Anjuman e Saifee").
WHATSAPP_DISPLAY_NAME_BROADCAST=

# Secret token for authenticating cron job requests (e.g., daily site scrape).
CRON_SECRET=

# Ashara daily content seeding (/api/cron/seed-majlis-day). ASHARA_START_DATE is the ISO
# date of Majlis 1 (2nd Muharram); the cron maps "today" to the right majlis and is a no-op
# when unset or outside the 10-day window. ASHARA_YEAR overrides the Hijri year label.
ASHARA_START_DATE=
ASHARA_YEAR=1448

# The app also accepts these Vercel variable names as aliases if they were
# already created with mixed-case names:
# Whatsapp_access_token -> WHATSAPP_ACCESS_TOKEN
# Whatsapp_phone_number_id -> WHATSAPP_PHONE_NUMBER_ID
# OpenAI_key -> OPENAI_API_KEY
# Supabase_url or Supabase_project_url -> SUPABASE_URL
# Supabase_service_role_key -> SUPABASE_SERVICE_ROLE_KEY
