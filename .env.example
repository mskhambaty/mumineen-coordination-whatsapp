META_GRAPH_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=choose-a-strong-random-string
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional, enables X-Hub-Signature-256 validation for Meta webhook POSTs.
META_APP_SECRET=

# Secret token for authenticating cron job requests (e.g., daily site scrape).
CRON_SECRET=

# The app also accepts these Vercel variable names as aliases if they were
# already created with mixed-case names:
# Whatsapp_access_token -> WHATSAPP_ACCESS_TOKEN
# Whatsapp_phone_number_id -> WHATSAPP_PHONE_NUMBER_ID
# OpenAI_key -> OPENAI_API_KEY
# Supabase_url or Supabase_project_url -> SUPABASE_URL
# Supabase_service_role_key -> SUPABASE_SERVICE_ROLE_KEY
