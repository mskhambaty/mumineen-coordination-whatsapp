# .env (chmod 600 — never commit)
# Loaded automatically by daily_analyzer.py at startup (tiny stdlib parser,
# no python-dotenv dep). Real env vars and CLI flags still override anything set here.

# Required for non-local endpoints. Script fails fast at startup if missing.
ANALYZER_API_KEY=sk-...

# Where the ingester writes captures and groups.json. Setting these here means
# you don't have to pass --captures-dir / --groups-file on every run.
CAPTURE_DIR=/home/asc/claw-message-ingester/captures
GROUPS_FILE=/home/asc/claw-message-ingester/groups.json

# Optional overrides — uncomment to change:
# ANALYZER_API_BASE=https://ollama.com/v1
# ANALYZER_MODEL=gemini-3-flash-preview
# LOG_DIR=./logs
